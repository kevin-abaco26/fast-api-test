# ---------------------------------------------------------------
# LOCAL DEVELOPMENT (MySQL via Docker)
# ---------------------------------------------------------------
DATABASE_URL=mysql+pymysql://abaco:secret@db:3306/abaco2

# RENDER PRODUCTION (PostgreSQL — Render injects this automatically)
# DATABASE_URL=postgresql://abaco:secret@host:5432/abaco2

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-use-openssl-rand-hex-32
ALGORITHM=HS256

# SendGrid
SENDGRID_API_KEY=SG.xxxx
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# Superuser (created on startup if missing)
SUPERUSER_EMAIL=admin@yourdomain.com
SUPERUSER_PASSWORD=changeme
SUPERUSER_NAMES=Admin
SUPERUSER_LAST_NAMES=System

# App
ENVIRONMENT=development
FAILED_LOGIN_THRESHOLD=5
VERIFICATION_CODE_TTL_MINUTES=5

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
